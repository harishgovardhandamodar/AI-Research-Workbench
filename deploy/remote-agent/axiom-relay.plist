<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- LaunchAgent: keep the axiom relay running across Mac reboots.
     Install: cp axiom-relay.plist ~/Library/LaunchAgents/com.fox.axiom-relay.plist
     (edit the ProgramArguments path to your checkout first)
     Then: launchctl load ~/Library/LaunchAgents/com.fox.axiom-relay.plist
     Logs: /tmp/axiom-relay.log -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.fox.axiom-relay</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/harishgovardhandamodar/codebase/AI-Research-Workbench/bin/axiom-relay.py</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/axiom-relay.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/axiom-relay.log</string>
</dict>
</plist>
