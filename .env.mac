# Mac / CPU deployment — no GPU
# Copy to .env or export before `docker compose up -d`:
#   cp .env.mac .env && docker compose up -d
# Base docker-compose.yml works without GPU by default; this file documents
# the explicit Mac values. For Linux+GPU use docker-compose.gpu.yml instead.

# App
FOX_BIND=127.0.0.1
FOX_BASE_URL=http://host.docker.internal:8081/v1
FOX_TOOL_BASE_URL=http://host.docker.internal:11435/v1
FOX_MODEL=qwen3.6:latest

# Editor (code-server at http://127.0.0.1:8788 — 8787 conflicts with caveman-proxy)
FOX_EDITOR_URL=http://127.0.0.1:8788
FOX_EDITOR_PROBE_URL=http://code-server:8080
FOX_EDITOR_FOLDER=/home/coder/workbench
CODE_SERVER_BIND=0.0.0.0
CODE_SERVER_AUTH=none
CODE_SERVER_PASSWORD=fox-workspace

# GPU — disabled on Mac (base compose has no reservation)
FOX_GPU_DEVICES=void
FOX_GPU_CAPABILITIES=compute,utility
FOX_GPU_COUNT=0

# Remote workbench (LAN / Tailscale hive-machine agents) — on-demand discovery only.
# REMOTE_HOSTS=http://axiom:8891
# REMOTE_USER=fox
# REMOTE_TOKEN=change-me-to-a-long-random-token

# Personal experiments repo — host bind mount for session snapshots + direct access
# Docker Compose mounts this path into the containers:
#   fox:          /app/mgmt-repo and /app/personal-experiments
#   code-server:  /home/coder/mgmt-repo and /home/coder/personal-experiments
PERSONAL_EXPERIMENTS_HOST_PATH=/Users/harishgovardhandamodar/codebase/personal-experiments
MANAGEMENT_REPO_DIR=/app/mgmt-repo
MANAGEMENT_GITHUB_REPO=
